<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict><key>title</key><string>Nulora Glass</string><key>items</key><array>
<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Стеклянное оформление</string><key>footerText</key><string>Оформление в стиле стекла для совместимых панелей UIKit на iOS 12. Верхняя строка сохраняет настоящие время, сеть и батарею. Это не перенос системного движка Liquid Glass из новой iOS. Игры, собственные панели приложений и все экраны системы не охватываются. После установки — ручной респринг.</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Включить Glass</string><key>key</key><string>enabled</string><key>defaults</key><string>com.theipos.glass</string><key>default</key><true/><key>PostNotification</key><string>com.theipos.glass/changed</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Время и батарея сверху</string><key>key</key><string>status</string><key>defaults</key><string>com.theipos.glass</string><key>default</key><true/><key>PostNotification</key><string>com.theipos.glass/changed</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Панели приложений</string><key>key</key><string>bars</string><key>defaults</key><string>com.theipos.glass</string><key>default</key><true/><key>PostNotification</key><string>com.theipos.glass/changed</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Баннеры уведомлений</string><key>key</key><string>banners</string><key>defaults</key><string>com.theipos.glass</string><key>default</key><true/><key>PostNotification</key><string>com.theipos.glass/changed</string></dict>
<dict><key>cell</key><string>PSSliderCell</string><key>label</key><string>Закругление</string><key>key</key><string>radius</string><key>defaults</key><string>com.theipos.glass</string><key>default</key><real>18</real><key>min</key><real>6</real><key>max</key><real>32</real><key>showValue</key><true/><key>PostNotification</key><string>com.theipos.glass/changed</string></dict>
